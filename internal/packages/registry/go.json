{
  "schema_version": 1,
  "name": "go",
  "version": "1.22.5",
  "description": "The Go programming language toolchain",
  "homepage": "https://go.dev",
  "license": "BSD-3-Clause",
  "source_repo": "https://github.com/golang/go",
  "source_url": "https://go.googlesource.com/go/+archive/refs/tags/go1.22.5.tar.gz",
  "source_tag": "go1.22.5",
  "build_system": "custom",
  "build_flags": ["GOROOT_BOOTSTRAP=/usr/local/go"],
  "make_targets": ["all"],
  "artifact_format": "tar.zst",
  "dependencies": [],
  "supported_platforms": [
    {"os": "linux",   "arch": "amd64"},
    {"os": "linux",   "arch": "arm64"},
    {"os": "linux",   "arch": "386"},
    {"os": "darwin",  "arch": "amd64"},
    {"os": "darwin",  "arch": "arm64"},
    {"os": "windows", "arch": "amd64"},
    {"os": "windows", "arch": "arm64"}
  ],
  "binaries": ["go", "gofmt"],
  "runtime_env": [
    {"name": "GOROOT", "value": "{{install_dir}}"},
    {"name": "PATH",   "value": "{{install_dir}}/bin", "prepend": true}
  ],
  "tags": ["compiler", "language", "toolchain", "go"]
}
