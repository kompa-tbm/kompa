{
  "schema_version": 1,
  "name": "sqlite",
  "version": "3.46.1",
  "description": "SQLite - self-contained, serverless, zero-configuration SQL database engine",
  "homepage": "https://www.sqlite.org",
  "license": "Public Domain",
  "source_repo": "https://github.com/sqlite/sqlite",
  "source_url": "https://www.sqlite.org/2024/sqlite-autoconf-3460100.tar.gz",
  "source_tag": "version-3.46.1",
  "source_sha256": "67d3fe6d268e6eaddcae3727fce58fcc8e9c53869bdd07a0c61e38ddf2965071",
