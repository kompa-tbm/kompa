{
  "schema_version": 1,
  "name": "gfortran",
  "version": "14.2.0",
  "description": "GNU Fortran compiler (part of GCC)",
  "homepage": "https://gcc.gnu.org/fortran/",
  "license": "GPL-3.0",
  "source_repo": "https://gcc.gnu.org/git/gcc.git",
  "source_url": "https://ftp.gnu.org/gnu/gcc/gcc-14.2.0/gcc-14.2.0.tar.xz",
  "source_tag": "releases/gcc-14.2.0",
  "source_sha256": "a7b39bc69cbf9e25826c5a60ab26477001f7c08d85cec04bc0e29cabed6f3cc9",
  "build_system": "autoconf",
  "configure_args": [
    "--enable-languages=c,fortran",
    "--disable-multilib",
    "--enable-shared",
    "--enable-static",
    "--with-system-zlib",
    "--disable-bootstrap"
  ],
  "make_targets": ["all", "install"],
  "artifact_format": "tar.zst",
  "dependencies": ["binutils", "gcc"],
  "build_dependencies": ["gmp", "mpfr", "mpc"],
  "supported_platforms": [
    {"os": "linux",  "arch": "amd64"},
    {"os": "linux",  "arch": "arm64"},
    {"os": "darwin", "arch": "amd64"},
    {"os": "darwin", "arch": "arm64"}
  ],
  "binaries": ["gfortran"],
  "libraries": ["libgfortran"],
  "runtime_env": [
    {"name": "FC", "value": "gfortran"}
  ],
  "tags": ["compiler", "fortran", "gnu", "toolchain", "scientific"]
}
